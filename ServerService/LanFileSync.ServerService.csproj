<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LanFileSync.ServerService</RootNamespace>
    <AssemblyName>BBKSyncService</AssemblyName>
    <Version>1.0.0</Version>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <!-- 零第三方依赖：直接 P/Invoke advapi32 SCM API 实现 Windows 服务 -->

    <!-- 自包含单文件发布：目标机无需安装 .NET -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <OptimizationPreference>Size</OptimizationPreference>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- appsettings.json 留在 exe 旁边供编辑，不打包进单文件 -->
    <IncludeAllContentForSelfExtract>false</IncludeAllContentForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ServerCore\LanFileSync.ServerCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

</Project>
