<Window x:Class="LanFileSync.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:LanFileSync"
        Title="连接历史" Height="440" Width="620"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent"
        TextElement.FontFamily="Microsoft YaHei UI, Segoe UI Variable, Segoe UI"
        TextElement.FontSize="13"
        StateChanged="Window_StateChanged">
    <WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32" GlassFrameThickness="0" CornerRadius="0"
                            ResizeBorderThickness="8" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <!-- 外层留白用于渲染柔和阴影 -->
    <Grid x:Name="rootHost" Margin="10">
        <Border x:Name="rootBorder" CornerRadius="12"
                Background="{DynamicResource WindowBgBrush}"
                BorderBrush="{DynamicResource WindowFrameBrush}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="0" Opacity="0.25" />
            </Border.Effect>
            <Grid x:Name="rootContent" local:CornerClip.Radius="11">
                <Grid.RowDefinitions>
                    <RowDefinition Height="32" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource TitleBarBgBrush}"
                BorderBrush="{DynamicResource TitleBarBorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource TitleBarButtonClose}" Click="TitleClose_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Path Width="12" Height="12" Stretch="Uniform" Data="M1,1 L9,9 M9,1 L1,9"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" />
                    </Button>
                </StackPanel>
                <TextBlock Text="连接历史" VerticalAlignment="Center" Margin="12,0,0,0"
                           Foreground="{DynamicResource TitleFgBrush}" FontWeight="SemiBold" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ListView x:Name="lvHistory" local:CornerClip.Radius="8">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="IP/主机" Width="150" DisplayMemberBinding="{Binding Host}" />
                        <GridViewColumn Header="备注" Width="200" DisplayMemberBinding="{Binding Note}" />
                        <GridViewColumn Header="最后使用" Width="120" DisplayMemberBinding="{Binding LastUsed}" />
                        <GridViewColumn Header="次数" Width="60" DisplayMemberBinding="{Binding Connects}" />
                    </GridView>
                </ListView.View>
            </ListView>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock Text="备注名称:" VerticalAlignment="Center" />
                <TextBox x:Name="txtNote" Width="220" Margin="6,0" VerticalContentAlignment="Center" />
                <Button Content="保存备注" Padding="10,3" Click="BtnSaveNote_Click" />
                <Button Content="删除记录" Padding="10,3" Margin="6,0,0,0" Click="BtnDelete_Click" />
            </StackPanel>
        </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>