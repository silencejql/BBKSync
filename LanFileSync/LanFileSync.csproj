<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LanFileSync</RootNamespace>
    <AssemblyName>BBKSync</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

    <!-- 体积优先优化 -->
    <OptimizationPreference>Size</OptimizationPreference>
    <!-- 只保留简体中文资源 -->
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
    <InvariantGlobalization>false</InvariantGlobalization>

    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <PlatformTarget>AnyCPU</PlatformTarget>
    
    <MinVerTagPrefix>v</MinVerTagPrefix>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
  </ItemGroup>

  <!--
    体积精简：自包含发布时 WindowsDesktop 运行时包会整包复制，其中
    - System.Windows.Forms.*（约 22MB）为 WinForms 运行时与设计器，本项目为纯 WPF，
      代码中没有任何 WinForms 引用，WPF 框架程序集也不依赖它们；
    - mscordaccore / mscordbi / Microsoft.DiaSymReader / createdump（约 6MB）仅用于调试与崩溃转储；
    - 打印/XPS、DirectoryServices、EventLog、HTTP、DataSet、并行 LINQ 等
      本项目完全未使用的框架服务（约 10MB），仅在调用对应功能时才会被加载。
    注意：System.Windows.Controls.Ribbon 不能删——WPF 的 presentation XML 命名空间
      会映射到 Ribbon 程序集，BAML 解析任意 xaml 类型（如 AncestorType）时都会加载它，
      删掉会导致启动即 XamlParseException / FileNotFoundException。
    注意：System.Configuration.ConfigurationManager 不能删——启动即崩溃（无窗口、事件
      日志 0xc000041d），已实测确认；DataContractSerialization / AsyncEnumerable /
      EventLog 已实测可删。
    从发布清单中剔除后不影响现有功能，单文件 exe 压缩后约省 12MB。
    注意：System.Drawing.Common 不能删——托盘图标 AppIcons 用到了 System.Drawing.Icon。
  -->
  <Target Name="PruneUnusedRuntimePackFiles" AfterTargets="ComputeResolvedFilesToPublishList" BeforeTargets="_HandleFileConflictsForPublish;_ComputeFilesToBundle;GenerateSingleFileBundle">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
        Condition="'%(Filename)' == 'System.Windows.Forms'
                or '%(Filename)' == 'System.Windows.Forms.Primitives'
                or '%(Filename)' == 'System.Windows.Forms.Design'
                or '%(Filename)' == 'System.Windows.Forms.Design.Editors'
                or '%(Filename)' == 'Microsoft.DiaSymReader.Native.amd64'
                or '%(Filename)' == 'createdump'
                or '%(Filename)' == 'mscordbi'
                or '%(Filename)' == 'ReachFramework'
                or '%(Filename)' == 'System.Printing'
                or '%(Filename)' == 'System.DirectoryServices'
                or '%(Filename)' == 'System.Diagnostics.EventLog.Messages'
                or '%(Filename)' == 'System.Net.Http'
                or '%(Filename)' == 'System.Data.Common'
                or '%(Filename)' == 'System.Linq.Parallel'
                or '%(Filename)' == 'System.Linq.AsyncEnumerable'
                or '%(Filename)' == 'System.Private.DataContractSerialization'
                or '%(Filename)' == 'System.Diagnostics.EventLog'
                or '%(Filename)' == 'System.Security.Cryptography.Pkcs'
                or $([System.String]::Copy('%(Filename)').StartsWith('mscordaccore'))" />
    </ItemGroup>
  </Target>

  <!-- README 作为嵌入资源打进 exe，发布时不产生单独文件；标题栏“?”按钮读取该资源 -->
  <ItemGroup>
    <EmbeddedResource Include="..\README.md" Link="README.md" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
  </ItemGroup>
  
  <ItemGroup>
    <PackageReference Include="MinVer" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>

  <!--
    MinVer 默认将 AssemblyVersion 固定为 major.0.0.0（程序集名版本，即
    Assembly.GetName().Version，窗口标题读取它），只有 FileVersion/ProductVersion 跟随 tag。
    这里在 MinVer 计算完成后把 AssemblyVersion 改写为完整的 major.minor.patch.0，
    使发布程序的所有版本号都跟随 git tag（如 tag v1.3.5 -> 1.3.5.0）。
  -->
  <Target Name="UseFullTagAssemblyVersion" AfterTargets="MinVer">
    <PropertyGroup>
      <AssemblyVersion>$(MinVerMajor).$(MinVerMinor).$(MinVerPatch).0</AssemblyVersion>
    </PropertyGroup>
  </Target>

</Project>