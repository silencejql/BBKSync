<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LanFileSync</RootNamespace>
    <AssemblyName>BBKSync</AssemblyName>
    <Version>1.3.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

    <!-- 体积优先优化 -->
    <OptimizationPreference>Size</OptimizationPreference>
    <!-- 只保留简体中文资源 -->
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- 启用压缩（会牺牲一点启动速度） -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <PlatformTarget>AnyCPU</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
  </ItemGroup>

  <!-- 以下文件已提取到 ServerCore 共享类库，避免重复定义 -->
  <ItemGroup>
    <Compile Remove="Net\PeerServer.cs" />
    <Compile Remove="Net\PeerConnection.cs" />
    <Compile Remove="Net\SourceSide.cs" />
    <Compile Remove="Net\TargetSide.cs" />
    <Compile Remove="Net\TransferSide.cs" />
    <Compile Remove="Net\FileLister.cs" />
    <Compile Remove="Sync\SyncEngine.cs" />
    <Compile Remove="Backup\BackupEngine.cs" />
    <Compile Remove="Backup\BackupSyncEngine.cs" />
    <Compile Remove="Transfer\TransferEngine.cs" />
    <Compile Remove="Models\SyncOptions.cs" />
    <Compile Remove="Models\BackupOptions.cs" />
    <Compile Remove="Models\FileEntry.cs" />
    <Compile Remove="Rules\UploadRules.cs" />
    <Compile Remove="Util\Constants.cs" />
    <Compile Remove="Util\AppPaths.cs" />
    <Compile Remove="Util\DeviceConfig.cs" />
    <Compile Remove="Util\FreeFormKiller.cs" />
    <Compile Remove="Util\ScriptRunner.cs" />
    <Compile Remove="Util\ZipHelper.cs" />
    <Compile Remove="Util\FileHelper.cs" />
    <Compile Remove="Util\SettingsStore.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ServerCore\LanFileSync.ServerCore.csproj" />
  </ItemGroup>

</Project>