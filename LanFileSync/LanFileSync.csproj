<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LanFileSync</RootNamespace>
    <AssemblyName>BBKSync</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

    <!-- 体积优先优化 -->
    <OptimizationPreference>Size</OptimizationPreference>
    <!-- 只保留简体中文资源 -->
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- 启用压缩（会牺牲一点启动速度） -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <PlatformTarget>AnyCPU</PlatformTarget>
    
    <MinVerTagPrefix>v</MinVerTagPrefix>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
  </ItemGroup>

  <!-- README 作为嵌入资源打进 exe，发布时不产生单独文件；标题栏“?”按钮读取该资源 -->
  <ItemGroup>
    <EmbeddedResource Include="..\README.md" Link="README.md" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
  </ItemGroup>
  
  <ItemGroup>
    <PackageReference Include="MinVer" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>

  <!--
    MinVer 默认将 AssemblyVersion 固定为 major.0.0.0（程序集名版本，即
    Assembly.GetName().Version，窗口标题读取它），只有 FileVersion/ProductVersion 跟随 tag。
    这里在 MinVer 计算完成后把 AssemblyVersion 改写为完整的 major.minor.patch.0，
    使发布程序的所有版本号都跟随 git tag（如 tag v1.3.5 -> 1.3.5.0）。
  -->
  <Target Name="UseFullTagAssemblyVersion" AfterTargets="MinVer">
    <PropertyGroup>
      <AssemblyVersion>$(MinVerMajor).$(MinVerMinor).$(MinVerPatch).0</AssemblyVersion>
    </PropertyGroup>
  </Target>

</Project>