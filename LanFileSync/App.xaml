<Application x:Class="LanFileSync.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Light.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 基础画刷(主题切换时动态更新) -->
            <SolidColorBrush x:Key="WindowBgBrush" Color="#F3F5F9" />
            <SolidColorBrush x:Key="CardBorderBrush" Color="#E1E6EE" />
            <SolidColorBrush x:Key="AccentBrush" Color="#2563EB" />
            <SolidColorBrush x:Key="InputBorderBrush" Color="#C9D2E0" />
            <SolidColorBrush x:Key="TextMainBrush" Color="#20242E" />
            <SolidColorBrush x:Key="TextSubBrush" Color="#6B7280" />
        </ResourceDictionary>
    </Application.Resources>
</Application>