<Application x:Class="LanFileSync.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Dark.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 基础画刷（主题切换时动态更新） -->
            <SolidColorBrush x:Key="WindowBgBrush" Color="#0D1117" />
            <SolidColorBrush x:Key="CardBorderBrush" Color="#1E2433" />
            <SolidColorBrush x:Key="AccentBrush" Color="#00D4FF" />
            <SolidColorBrush x:Key="InputBorderBrush" Color="#2A3040" />
            <SolidColorBrush x:Key="TextMainBrush" Color="#E6EDF3" />
            <SolidColorBrush x:Key="TextSubBrush" Color="#7D8590" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
