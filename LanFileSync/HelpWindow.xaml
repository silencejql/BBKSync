<Window x:Class="LanFileSync.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:LanFileSync"
        Title="使用说明" Height="700" Width="900"
        MinHeight="480" MinWidth="640"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent"
        TextElement.FontFamily="Microsoft YaHei UI, Segoe UI Variable, Segoe UI"
        TextElement.FontSize="13"
        StateChanged="Window_StateChanged">
    <WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32" GlassFrameThickness="0" CornerRadius="0"
                            ResizeBorderThickness="8" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Grid x:Name="rootHost">
        <Border x:Name="rootBorder" CornerRadius="12"
                Background="{DynamicResource WindowBgBrush}"
                BorderBrush="{DynamicResource WindowFrameBrush}" BorderThickness="1">
            <Grid x:Name="rootContent" local:CornerClip.Radius="11">
                <Grid.RowDefinitions>
                    <RowDefinition Height="32" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource TitleBarBgBrush}"
                        BorderBrush="{DynamicResource TitleBarBorderBrush}" BorderThickness="0,0,0,1">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource TitleBarButtonClose}" Click="TitleClose_Click"
                                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
                                <Path Width="12" Height="12" Stretch="Uniform" Data="M1,1 L9,9 M9,1 L1,9"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" />
                            </Button>
                        </StackPanel>
                        <TextBlock Text="使用说明（README）" VerticalAlignment="Center" Margin="12,0,0,0"
                                   Foreground="{DynamicResource TitleFgBrush}" FontWeight="SemiBold" />
                    </DockPanel>
                </Border>

                <FlowDocumentScrollViewer Grid.Row="1" x:Name="viewer"
                                          IsToolBarVisible="False"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Background="{DynamicResource WindowBgBrush}" />
            </Grid>
        </Border>
    </Grid>
</Window>
