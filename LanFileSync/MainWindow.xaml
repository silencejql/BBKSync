                                                               Visibility="Collapsed" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </TabItem>
                                <TabItem Header="程序升级" Width="100">
                                    <Grid Margin="0" IsEnabled="{Binding IsNotBusy}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="更新远端电脑的 BBKSync 程序" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextSubBrush}" Margin="0,0,0,6" />
