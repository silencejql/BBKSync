<Window x:Class="LanFileSync.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="BBK文件同步与备份工具"
        Icon="/app.ico"
        MinHeight="680" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent"
        BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="0.1"
        TextElement.FontFamily="Microsoft YaHei UI, Segoe UI Variable, Segoe UI"
        TextElement.FontSize="13"
        Loaded="MainWindow_Loaded"
        StateChanged="Window_StateChanged"
        Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextMainBrush}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#DCE7FA" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#B7CDF4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TitleBarButtonClose" TargetType="Button">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextMainBrush}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E81123" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#B8091E" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Border BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="2">
        <Grid Background="{DynamicResource WindowBgBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 自定义标题栏 -->
            <Border x:Name="titleBarBorder" Grid.Row="0" Background="{DynamicResource TitleBarBgBrush}"
                    BorderBrush="{DynamicResource TitleBarBorderBrush}" BorderThickness="0,0,0,1">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="btnThemeToggle" Style="{StaticResource ThemeToggleButton}"
                                Click="BtnThemeToggle_Click" Margin="0,0,4,0"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                        <Button Style="{StaticResource TitleBarButton}" Click="TitleMin_Click" ToolTip="最小化"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <Path Width="12" Height="12" Stretch="Uniform" Data="M0,6 H10"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" />
                        </Button>
                        <Button Style="{StaticResource TitleBarButton}" Click="TitleMax_Click" ToolTip="最大化 / 还原"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <Path Width="12" Height="12" Stretch="Uniform" Data="M1,1 H9 V9 H1 Z"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" />
                        </Button>
                        <Button Style="{StaticResource TitleBarButtonClose}" Click="TitleClose_Click" ToolTip="关闭"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <Path Width="12" Height="12" Stretch="Uniform" Data="M1,1 L9,9 M9,1 L1,9"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" />
                        </Button>
                    </StackPanel>
                    <Image Source="/app.ico" Width="18" Height="18" Margin="10,0,10,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="txtTitle" Text="BBKFileSync" VerticalAlignment="Center" FontWeight="SemiBold"
                               Foreground="{DynamicResource TitleFgBrush}" TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Border>

            <!-- 主界面内容 -->
            <DockPanel Grid.Row="1">
                <!-- 底部状态栏 -->
                <Border DockPanel.Dock="Bottom" Height="30" Background="{DynamicResource StatusBarBgBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0">
                    <DockPanel Margin="12,0">
                        <TextBlock DockPanel.Dock="Right" x:Name="txtLocalIp" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSubBrush}" Text="未启动服务" TextElement.FontSize="12" />
                        <TextBlock x:Name="txtStatus" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextMainBrush}" Text="就绪" TextElement.FontSize="12" />
                    </DockPanel>
                </Border>

                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="210" MinHeight="90" />
                    </Grid.RowDefinitions>

                    <!-- 主操作区：整窗横跨排列 -->
                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- 第一行：本机服务 | 对方电脑 -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <GroupBox Header="本机配置">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="BBK文件夹:" VerticalAlignment="Center" FontWeight="Bold" />
                                            <TextBox x:Name="txtRoot" Grid.Column="1" Margin="8,0,0,0" Height="30" HorizontalAlignment="Left" MinWidth="150" />
                                            <Button Grid.Column="2" Content="浏览..." Padding="12,6" Margin="8,0,0,0" Click="BtnBrowse_Click" />
                                            <TextBlock Text="本机端口:" Grid.Column="3" Margin="8,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold" />
                                            <TextBox x:Name="txtPort" Grid.Column="4" Margin="8,0,0,0" Height="30" Width="80" HorizontalAlignment="Right"
                                             ToolTip="本机服务监听端口" />
                                        </Grid>
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="btnStart" Grid.Column="2" Content="启动服务" Margin="10,0,0,0" Click="BtnStartServer_Click" />
                                            <Button x:Name="btnStop" Grid.Column="3" Content="停止服务" IsEnabled="False" Margin="10,0,0,0" Click="BtnStopServer_Click" />
                                            <CheckBox x:Name="chkAutoStart" Grid.Column="1" Margin="0,0,0,0" FontWeight="Normal"
                                              Content="开机自启并后台监听(驻留托盘)"
                                              VerticalAlignment="Center" IsChecked="False"
                                              Checked="ChkAutoStart_Changed" Unchecked="ChkAutoStart_Changed" />
                                        </Grid>
                                    </StackPanel>
                                </GroupBox>

                                <GroupBox Grid.Column="1" Header="远端电脑(备份 / 更新)" Margin="14,0,0,0">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="IP/范围:" VerticalAlignment="Center" FontWeight="Bold" />
                                            <ComboBox x:Name="cboPeerIp" Grid.Column="1" Margin="8,0,0,0" Height="30" IsEditable="True"
                                          VerticalContentAlignment="Center"
                                          ToolTip="可下拉选择历史记录或配置过的电脑，也可直接输入多个 IP(逗号分隔)或范围。例：192.168.1.5,192.168.1.8-10。">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Label}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <Button x:Name="btnTestConnect" Grid.Column="2" Content="测试连接" Margin="8,0,0,0" Padding="10,6"
                                            Click="BtnTestConnect_Click" ToolTip="验证与对方 IP 和端口的 TCP 连接是否可达" />
                                            <Button x:Name="btnHistory" Grid.Column="3" Content="历史" Margin="8,0,0,0" Padding="10,6"
                                            Click="BtnHistory_Click" ToolTip="管理历史连接的 IP 与备注" />
                                            <Button x:Name="btnComputers" Grid.Column="4" Content="IP配置" Margin="8,0,0,0" Padding="10,6"
                                            Click="BtnComputers_Click" ToolTip="配置 IP 与电脑名称的对应关系，用于下拉选择和备份自动命名" />
                                        </Grid>
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="对方端口:" VerticalAlignment="Center" FontWeight="Bold" />
                                            <TextBox x:Name="txtPeerPort" Grid.Column="1" Width="90" Margin="8,0,0,0" Height="30"
                                             ToolTip="对方服务监听端口。软件打开后会自动启动服务，端口即以本机端口为准" />
                                            <TextBlock Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSubBrush}" TextWrapping="Wrap" FontSize="10"
                                               Text="多台依次处理：逗号分隔，或范围如 192.168.1.5-8、192.168.1.5-192.168.1.8" />
                                        </Grid>
                                    </StackPanel>
                                </GroupBox>
                            </Grid>

                            <!-- 选项卡：备份 / 更新(横跨整个界面) -->
                            <TabControl x:Name="tabs" Margin="-2,10,0,0" SelectionChanged="Tabs_SelectionChanged">
                                <TabItem Header="BBK备份" Width="100">
                                    <Grid Margin="6,10,6,06">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="来源:" VerticalAlignment="Center" />
                                                <RadioButton x:Name="rbBackupLocal" GroupName="bsrc" Content="本机" IsChecked="True" Margin="10,0,0,0" VerticalAlignment="Center" Checked="RbBackupSource_Changed" />
                                                <RadioButton x:Name="rbBackupRemote" GroupName="bsrc" Content="局域网电脑(可多台)" Margin="10,0,0,0" VerticalAlignment="Center" Checked="RbBackupSource_Changed" />
                                                <RadioButton x:Name="rbBackupShare" GroupName="bsrc" Content="Windows共享" Margin="10,0,0,0" VerticalAlignment="Center" Checked="RbBackupSource_Changed" />
                                            </StackPanel>
                                            <TextBlock x:Name="txtBackupHint" Margin="0,7,0,0" Foreground="{DynamicResource TextSubBrush}" TextWrapping="Wrap" FontSize="10" FontWeight="Normal"
                                               Text="局域网电脑备份用上方&#x201c;远端电脑&#x201d;的 IP/范围，逐台处理；Windows共享用下方连接。" />
                                            <Grid Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="备份到:" VerticalAlignment="Center" />
                                                <TextBox x:Name="txtBackupDest" Grid.Column="1" Margin="8,0,0,0" Height="30" FontWeight="Normal"
                                                 ToolTip="备份目标父目录，实际自动存入 备份目录\BBK_电脑名称_日期(可为本地盘或已映射的网络盘)" />
                                                <Button Grid.Column="2" Content="浏览..." Padding="12,6" Margin="8,0,0,0" Click="BtnBackupBrowse_Click" />
                                            </Grid>
                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                <CheckBox x:Name="cbBackupLogRule" Content="Log 文件夹只备份最近" IsChecked="True" VerticalAlignment="Center" />
                                                <TextBox x:Name="txtBackupLogDays" Width="50" Height="20" Margin="6,0" Text="2" VerticalContentAlignment="Center" />
                                                <TextBlock Text="天" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <StackPanel x:Name="rowLocalName" Orientation="Horizontal" Margin="0,8,0,0">
                                                <CheckBox x:Name="cbAutoFetchName" VerticalAlignment="Center"
                                                  IsChecked="True"
                                                  Content="自动获取设备配置"
                                                  ToolTip="勾选后自动从备份电脑 BBK 文件夹子目录的 Config\SystemConfig.xml 解析 DeviceNo/LineNo 作为备份命名与存放。" />
                                            </StackPanel>
                                            <CheckBox x:Name="cbCompressZip" Content="备份完成后自动压缩为 zip(删除备份文件夹)" IsChecked="True" Margin="0,8,0,0"
                                              ToolTip="备份完成后将备份文件夹打包成同名 zip 文件并删除文件夹，节省空间。" />
                                            <CheckBox x:Name="cbRunPreBackupBat" Content="备份前先执行PostgreSQL备份脚本" IsChecked="False" Margin="0,8,0,0"
                                              ToolTip="勾选后开始备份前先执行目标电脑预设的脚本(PostgreSQL_Backup.bat，默认含 pg_dump 数据库备份命令)：局域网备份在对方电脑执行(成功后再拉取备份文件)。" />
                                        </StackPanel>
                                        <Rectangle Grid.Column="1" Width="1" Fill="{DynamicResource CardBorderBrush}" Margin="14,0" />
                                        <StackPanel Grid.Column="2" Margin="5,0,0,0">
                                            <CheckBox x:Name="cbIgnoreEnabled" Content="启用忽略规则(正则表达式)" IsChecked="True"
                                              ToolTip="取消勾选后，下面的忽略规则不生效，所有文件都会被备份。" />
                                            <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource TextSubBrush}" TextWrapping="Wrap" FontSize="10" FontWeight="Normal"
                                               Text="忽略文件/文件夹(每行一条正则表达式，匹配相对路径)：" />
                                            <TextBox x:Name="txtBackupIgnore" Margin="0,4,0,0" Height="60" AcceptsReturn="True"
                                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalAlignment="Stretch"
                                             ToolTip="每行一条合法正则表达式，大小写不敏感，匹配文件/文件夹相对源目录的路径，命中即忽略备份。&#x0a;&#x0a;忽略文件示例：&#x0a;&#x0a;  Log\.log$           结尾为 Log.log 的文件&#x0a;&#x0a;  \.bak$              所有 .bak 文件(注意 * 号无效，这是正则)&#x0a;&#x0a;  副本                 路径中含&#x201c;副本&#x201d;的文件&#x0a;&#x0a;忽略文件夹示例：&#x0a;&#x0a;  (^|/)\.git(/|$)      任何路径下的 .git 文件夹&#x0a;&#x0a;  (^|/)Temp(/|$)       顶层 Temp 文件夹&#x0a;&#x0a;  若要整条容错，可用 ^ 和 $ 锁定。" />
                                            <TextBlock x:Name="txtIgnoreExample" Margin="0,6,0,0" Foreground="{DynamicResource TextSubBrush}" TextWrapping="Wrap" FontSize="10" FontWeight="Normal"
                                               Text="示例：忽略 .bak 文件：\.bak$；忽略全部副本文件：副本；忽略 .git 文件夹：(^|/)\.git(/|$)。" />
                                            <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource TextSubBrush}" TextWrapping="Wrap" FontSize="10" FontWeight="Normal"
                                               Text="备份自动存入 备份目录\BBK_电脑名称_日期。" />
                                        </StackPanel>
                                    </Grid>
                                </TabItem>
                                <TabItem Header="BBK更新" Width="100">
                                    <Grid Margin="6,10,6,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="更新方式" FontWeight="SemiBold" Foreground="{DynamicResource TextSubBrush}" Margin="0,0,0,6" />
                                            <RadioButton x:Name="rbReceive" GroupName="dir" Content="接收对方更新(对方为源)" Checked="RbDir_Changed" Margin="0,3,0,0" />
                                            <RadioButton x:Name="rbPush" GroupName="dir" Content="推送本机给对方(本机为源)" Margin="0,6,0,0" Checked="RbDir_Changed" />
                                            <RadioButton x:Name="rbSyncShare" GroupName="dir" Content="从共享文件夹更新本机(免安装)" Margin="0,6,0,0" Checked="RbDir_Changed" />
                                            <TextBlock x:Name="txtHint" Margin="0,8,0,0" Foreground="{DynamicResource TextSubBrush}" TextWrapping="Wrap" FontSize="10" FontWeight="Normal"
                                               Text="接收对方更新：对方需先&#x201c;启动服务&#x201d;。更新规则按本机设置执行。" />
                                            <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource TextSubBrush}" TextWrapping="Wrap" FontSize="10" FontWeight="Normal"
                                               Text="说明：更新BBK文件夹，自动跳过 Log 与 Config 文件夹。" />
                                        </StackPanel>
                                        <Rectangle Grid.Column="1" Width="1" Fill="{DynamicResource CardBorderBrush}" Margin="14,0" />
                                        <StackPanel Grid.Column="2" Margin="14,0,0,0">
                                            <TextBlock Text="更新规则(接收 / 从共享时生效)" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSubBrush}" Margin="0,0,0,6" />
                                            <CheckBox x:Name="cbBinReplace" Content="Bin 整体替换(不勾则按日期增量)" Margin="0,3,0,0"
                                              ToolTip="勾选：先删除本地 Bin 再整体拷贝。不勾选：按修改日期/大小只传输不同的文件。" />

                                            <CheckBox x:Name="cbBackupBeforeSync" Margin="0,10,0,0" IsChecked="True"
                                              Content="同步更新前先备份被更新电脑的 BBK(规则同备份)"
                                              ToolTip="TCP 接收更新、从共享更新本机、或对方推送更新时，都会先把被更新那台电脑的 BBK 备份到&#x201c;备份目录&#x201d;再开始同步。" />
                                            <CheckBox x:Name="cbUpdateCompressZip" Margin="0,6,0,0" IsChecked="True"
                                              Content="备份完成后自动压缩为 zip(删除备份文件夹)"
                                              ToolTip="勾选后，同步更新前的备份(本机或对方电脑)完成后自动打包成同名 zip 并删除备份文件夹。" />
                                        </StackPanel>
                                        <!-- 半透明玻璃遮罩(密码保护) -->
                                        <Border x:Name="updateOverlay" Grid.ColumnSpan="3"
                                                CornerRadius="8" IsHitTestVisible="True" ClipToBounds="True">
                                            <Grid>
                                                <Border Background="{DynamicResource OverlayBgBrush}" CornerRadius="8">
                                                    <Border.Effect>
                                                        <BlurEffect Radius="6" KernelType="Gaussian" />
                                                    </Border.Effect>
                                                </Border>
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="500">
                                                    <TextBlock Text="请输入密码以使用更新功能" FontSize="18"
                                                               Foreground="{DynamicResource TextMainBrush}" HorizontalAlignment="Center" Margin="0,10,0,5" />
                                                    <Border HorizontalAlignment="Stretch" Background="{DynamicResource CardBgBrush2}"
                                                            BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1"
                                                            CornerRadius="5" SnapsToDevicePixels="True">
                                                        <Grid Height="40" HorizontalAlignment="Stretch">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <PasswordBox x:Name="pwdUpdate" Grid.Column="0"
                                                                         FontSize="14" Padding="10,6,5,6" BorderThickness="0"
                                                                         Background="Transparent" VerticalContentAlignment="Center"
                                                                         KeyDown="PwdUpdate_KeyDown" />
                                                            <TextBox x:Name="txtUpdatePwd" Grid.Column="0"
                                                                     FontSize="14" Padding="10,6,5,6" VerticalContentAlignment="Center"
                                                                     Visibility="Collapsed" BorderThickness="0" Background="Transparent"
                                                                     KeyDown="PwdUpdate_KeyDown" />
                                                            <Button x:Name="btnTogglePwd" Grid.Column="1" Width="50"
                                                                    Margin="0,0,4,0" Cursor="Hand"
                                                                    Background="Transparent" BorderThickness="0"
                                                                    Click="BtnTogglePwd_Click"
                                                                    ToolTip="显示 / 隐藏密码">
                                                                <Grid Width="18" Height="18">
                                                                    <Path x:Name="eyeIcon" Stretch="Uniform"
                                                                          Data="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"
                                                                          Fill="{DynamicResource TextSubBrush}" />
                                                                    <Line x:Name="eyeLine" X1="2" Y1="2" X2="22" Y2="22"
                                                                          Stroke="{DynamicResource TextSubBrush}" StrokeThickness="2"
                                                                          Visibility="Visible" />
                                                                </Grid>
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                    <Button Content="确认" Padding="14,6" HorizontalAlignment="Center"
                                                            Margin="0,5,0,0" Click="BtnUpdateUnlock_Click"
                                                            Style="{StaticResource AccentButton}" />
                                                    <TextBlock x:Name="txtUpdateError" Text="密码错误" FontSize="11"
                                                               Foreground="#E81123" HorizontalAlignment="Center" Margin="0,6,0,0"
                                                               Visibility="Collapsed" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </TabItem>
                                <TabItem Header="文件同步" Width="100">
                                    <Grid Margin="6,10,6,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="选择本地文件或文件夹(LAN 远程传输)" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSubBrush}" Margin="0,0,0,6" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="路径:" VerticalAlignment="Center" />
                                                <TextBox x:Name="txtTransferPath" Grid.Column="1" Margin="8,0,0,0" Height="30"
                                                 ToolTip="本机要传输到对方电脑的文件或文件夹完整路径(保留原名，传到对方电脑的相同路径)" />
                                                <Button Grid.Column="2" Content="选择文件..." Padding="10,6" Margin="8,0,0,0" Click="BtnTransferFile_Click" />
                                                <Button Grid.Column="3" Content="选择文件夹..." Padding="10,6" Margin="8,0,0,0" Click="BtnTransferDir_Click" />
                                            </Grid>
                                            <TextBlock x:Name="txtTransferHint" Margin="0,10,0,0" Foreground="{DynamicResource TextSubBrush}" TextWrapping="Wrap" FontSize="10" FontWeight="Normal"
                                               Text="将选中的文件/文件夹更新到对方电脑的相同路径(对方需先&#x201c;启动服务&#x201d;)。同名同大小同修改时间的文件会跳过。" />
                                            <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource TextSubBrush}" TextWrapping="Wrap" FontSize="10" FontWeight="Normal"
                                               Text="更新前会自动备份对方相应的文件/文件夹(原文件重命名为&#x201c;原名-更新自动备份-日期&#x201d;)。" />
                                        </StackPanel>
                                        <Rectangle Grid.Column="1" Width="1" Fill="{DynamicResource CardBorderBrush}" Margin="14,0" />
                                        <StackPanel Grid.Column="2" Margin="14,0,0,0">
                                            <TextBlock Text="更新设置" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSubBrush}" Margin="0,0,0,6" />
                                            <CheckBox x:Name="cbTransferSameSkip" Content="修改时间与大小都相同则跳过传输" IsChecked="True" Margin="0,3,0,0"
                                              ToolTip="勾选后，目标电脑上已存在且大小、修改时间相同的文件不再重复传输。" />

                                            <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource TextSubBrush}" TextWrapping="Wrap" FontSize="10" FontWeight="Normal"
                                               Text="说明：传输的目标路径与本机完全相同(如本机 D:\X\bin\app.exe 将传到对方 D:\X\bin\app.exe)。" />
                                        </StackPanel>
                                    </Grid>
                                </TabItem>
                                <TabItem Header="进程管理" Width="100">
                                    <Grid Margin="6,10,6,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel x:Name="processContent" IsEnabled="False">
                                            <TextBlock Text="远程管理 FreeFormAlways 进程" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextSubBrush}" Margin="0,0,0,6" />
                                            <Grid Margin="0,0,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="启动程序路径:" VerticalAlignment="Center" />
                                                <ComboBox x:Name="txtProcessPath" Grid.Column="1" Margin="8,0,0,0" Height="30" IsEditable="True"
                                                          VerticalContentAlignment="Center"
                                                          ToolTip="要启动的程序完整路径(如 D:\FreeForm\bin\FreeFormAlways.exe)。点击&#x201c;获取xmlFreeForm文件列表&#x201d;后可下拉选择远端文件。" />
                                                <Button Grid.Column="2" Content="浏览..." Padding="12,6" Margin="8,0,0,0" Click="BtnProcessBrowse_Click" />
                                            </Grid>
                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="文件后缀:" VerticalAlignment="Center" />
                                                <TextBox x:Name="txtProcessFileSuffixes" Grid.Column="1" Margin="8,0,0,0" Height="30"
                                                         Text="xmlFreeForm" ToolTip="要匹配的文件后缀或关键字，多个用逗号或分号分隔" />
                                            </Grid>
                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                <Button x:Name="btnProcessFetchFiles" Content="获取xmlFreeForm文件列表" Padding="14,6"
                                                        Click="BtnProcessFetchFiles_Click" />
                                                <Button x:Name="btnProcessOpen" Margin="8,0,0,0" Padding="14,6"
                                                        Content="启动远端应用程序" Click="BtnProcessOpen_Click" />
                                            </StackPanel>
                                            <TextBlock x:Name="txtProcessStatus" Margin="0,8,0,0" Foreground="{DynamicResource TextMainBrush}" TextWrapping="Wrap" FontSize="11"
                                                       FontWeight="SemiBold" />
                                        </StackPanel>
                                        <Rectangle Grid.Column="1" Width="1" Fill="{DynamicResource CardBorderBrush}" Margin="14,0" />
                                        <StackPanel Grid.Column="2" Margin="14,0,0,0">
                                            <TextBlock Text="操作" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextSubBrush}" Margin="0,0,0,6" />
                                            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSubBrush}" FontSize="11" Margin="0,0,0,8"
                                                       Text="启动或关闭远端电脑的 FreeFormAlways 进程。&#x0a;远端电脑需先启动 BBK 服务。" />
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="关闭进程前缀:" VerticalAlignment="Center" ToolTip="要结束的远端进程名前缀，多个用逗号或分号分隔" />
                                                <TextBox x:Name="txtProcessKillNames" Grid.Column="1" Margin="8,0,0,0" Height="30"
                                                         ToolTip="要结束的远端进程名前缀，多个用逗号或分号分隔。留空则使用 FreeFormAlways。&#x0a;例：FreeFormAlways,MyApp;AnotherApp" />
                                            </Grid>
                                            <TextBlock x:Name="txtProcessHint" Margin="0,0,0,6" Foreground="{DynamicResource TextSubBrush}" TextWrapping="Wrap" FontSize="10"
                                                       Text="获取：从对端 D:\BBK 列出匹配后缀的文件，写入启动路径下拉框供选择。&#x0a;关闭：结束远端指定进程名前缀的进程。" />
                                            <Button x:Name="btnProcessClose" Content="关闭远端应用程序" Padding="14,6" Margin="0,0,0,5"
                                                    Click="BtnProcessClose_Click" />
                                        </StackPanel>
                                        <!-- 半透明玻璃遮罩(密码保护) -->
                                        <Border x:Name="processOverlay" Grid.ColumnSpan="3"
                                                CornerRadius="8" IsHitTestVisible="True" ClipToBounds="True">
                                            <Grid>
                                                <Border Background="{DynamicResource OverlayBgBrush}" CornerRadius="8">
                                                    <Border.Effect>
                                                        <BlurEffect Radius="6" KernelType="Gaussian" />
                                                    </Border.Effect>
                                                </Border>
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="500">
                                                    <TextBlock Text="请输入密码以使用 进程管理 功能" FontSize="18"
                                                               Foreground="{DynamicResource TextMainBrush}" HorizontalAlignment="Center" Margin="0,10,0,5" />
                                                    <Border HorizontalAlignment="Stretch" Background="{DynamicResource CardBgBrush2}"
                                                            BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1"
                                                            CornerRadius="5" SnapsToDevicePixels="True">
                                                        <Grid Height="40" HorizontalAlignment="Stretch">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <PasswordBox x:Name="pwdProcess" Grid.Column="0"
                                                                         FontSize="14" Padding="10,6,5,6" BorderThickness="0"
                                                                         Background="Transparent" VerticalContentAlignment="Center"
                                                                         KeyDown="PwdProcess_KeyDown" />
                                                            <TextBox x:Name="txtProcessPwd" Grid.Column="0"
                                                                     FontSize="14" Padding="10,6,5,6" VerticalContentAlignment="Center"
                                                                     Visibility="Collapsed" BorderThickness="0" Background="Transparent"
                                                                     KeyDown="PwdProcess_KeyDown" />
                                                            <Button x:Name="btnToggleProcessPwd" Grid.Column="1" Width="50"
                                                                    Margin="0,0,4,0" Cursor="Hand"
                                                                    Background="Transparent" BorderThickness="0"
                                                                    Click="BtnToggleProcessPwd_Click"
                                                                    ToolTip="显示 / 隐藏密码">
                                                                <Grid Width="18" Height="18">
                                                                    <Path x:Name="eyeIconProcess" Stretch="Uniform"
                                                                          Data="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"
                                                                          Fill="{DynamicResource TextSubBrush}" />
                                                                    <Line x:Name="eyeLineProcess" X1="2" Y1="2" X2="22" Y2="22"
                                                                          Stroke="{DynamicResource TextSubBrush}" StrokeThickness="2"
                                                                          Visibility="Visible" />
                                                                </Grid>
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                    <Button Content="确认" Padding="14,6" HorizontalAlignment="Center"
                                                            Margin="0,5,0,0" Click="BtnProcessUnlock_Click"
                                                            Style="{StaticResource AccentButton}" />
                                                    <TextBlock x:Name="txtProcessError" Text="密码错误" FontSize="11"
                                                               Foreground="#E81123" HorizontalAlignment="Center" Margin="0,6,0,0"
                                                               Visibility="Collapsed" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </TabItem>
                                <TabItem Header="程序升级" Width="100">
                                    <Grid Margin="6,10,6,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="更新远端电脑的 BBKSync 程序" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextSubBrush}" Margin="0,0,0,6" />
                                            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSubBrush}" FontSize="11"
                                                       Text="将本机当前运行的 BBKSync.exe 发送到远端电脑并自动替换。&#x0a;远端电脑需先启动 BBK 服务。" />
                                            <TextBlock Margin="0,10,0,0" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextSubBrush}" Text="更新步骤：" />
                                            <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource TextSubBrush}" FontSize="11" TextWrapping="Wrap"
                                                       Text="1. 本机自动将当前 BBKSync.exe 发送到远端电脑" />
                                            <TextBlock Margin="0,2,0,0" Foreground="{DynamicResource TextSubBrush}" FontSize="11" TextWrapping="Wrap"
                                                       Text="2. 远端电脑执行脚本：关闭旧程序 → 删除旧程序 → 重命名新程序 → 启动新程序" />
                                        </StackPanel>
                                        <Rectangle Grid.Column="1" Width="1" Fill="{DynamicResource CardBorderBrush}" Margin="14,0" />
                                        <StackPanel Grid.Column="2" Margin="14,0,0,0">
                                            <TextBlock Text="注意事项" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextSubBrush}" Margin="0,0,0,6" />
                                            <TextBlock Foreground="{DynamicResource TextSubBrush}" FontSize="11" TextWrapping="Wrap"
                                                       Text="• 更新期间远端 BBK 服务会短暂中断(约 5 秒)" />
                                            <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource TextSubBrush}" FontSize="11" TextWrapping="Wrap"
                                                       Text="• 更新完成后远端程序会自动重新启动" />
                                            <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource TextSubBrush}" FontSize="11" TextWrapping="Wrap"
                                                       Text="• 确保本机和远端电脑的 BBKSync 版本架构一致(均为 x64)" />
                                            <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource TextSubBrush}" FontSize="11" TextWrapping="Wrap"
                                                       Text="• 更新前建议先关闭远端电脑上正在运行的 BBK 相关操作" />
                                        </StackPanel>
                                    </Grid>
                                </TabItem>
                            </TabControl>

                            <!-- 传输与进度 -->
                            <GroupBox Header="传输与进度" Margin="0,14,0,0">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="btnBackup" Content="开始备份" Style="{StaticResource AccentButton}" Padding="20,7" IsEnabled="False"
                                        Click="BtnBackup_Click" />
                                        <Button x:Name="btnSync" Grid.Column="1" Content="开始更新" IsEnabled="False" Margin="8,0,0,0"
                                        Padding="20,7" Style="{StaticResource AccentButton}" Click="BtnSync_Click" />
                                        <Button x:Name="btnUpdateProgram" Grid.Column="2" Content="程序升级" IsEnabled="False" Margin="8,0,0,0"
                                        Padding="20,7" Style="{StaticResource AccentButton}" Click="BtnUpdateProgram_Click" />
                                        <Button x:Name="btnCancel" Grid.Column="4" Content="取消" IsEnabled="False" Click="BtnCancel_Click" />
                                    </Grid>
                                    <ProgressBar x:Name="progressBar" Margin="0,12,0,0" Minimum="0" Maximum="1" />
                                    <TextBlock x:Name="txtCur" Margin="0,7,0,0" Text="进度: -" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </GroupBox>

                            <!-- Windows 共享连接(仅在勾选“从共享更新”时显示) -->
                            <GroupBox x:Name="grpShare" Header="Windows 共享连接(对方免安装)" Margin="0,14,0,0" Visibility="Collapsed">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="对方IP:" VerticalAlignment="Center" />
                                        <TextBox x:Name="txtShareIp" Grid.Column="1" Margin="8,0,0,0" Height="30"
                                         ToolTip="对方电脑 IP，例如 192.168.1.8" />
                                        <TextBlock Grid.Column="2" Text="用户名:" Margin="16,0,0,0" VerticalAlignment="Center" />
                                        <TextBox x:Name="txtShareUser" Grid.Column="3" Margin="8,0,0,0" Height="30"
                                         ToolTip="共享账号(留空用当前 Windows 账号)" />
                                        <TextBlock Grid.Column="4" Text="密码:" Margin="16,0,0,0" VerticalAlignment="Center" />
                                        <PasswordBox x:Name="pwdSharePass" Grid.Column="5" Margin="8,0,0,0" Height="30"
                                             ToolTip="共享密码(可留空)" />
                                        <TextBlock Grid.Column="6" Text="共享路径:" Margin="16,0,0,0" VerticalAlignment="Center" />
                                        <TextBox x:Name="txtSharePath" Grid.Column="7" Margin="8,0,0,0" Height="30" Text="c$\BBK"
                                         ToolTip="对方共享的 BBK 路径。默认 c$\BBK 即对方 C 盘下的 BBK；若对方把 BBK 文件夹直接共享为&quot;BBK&quot;则填 BBK" />
                                    </Grid>
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="btnShareTest" Content="测试连接" Padding="14,6" Click="BtnShareTest_Click" />
                                        <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSubBrush}" TextWrapping="Wrap"
                                           Text="对方只需共享 D:\BBK(或开放 c$ 管理共享)，无需安装本程序。" />
                                    </Grid>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 日志区拖拽分隔条 -->
                    <GridSplitter Grid.Row="1" Height="7" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                          Background="Transparent" Cursor="SizeNS" ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Rows" />
                    <Border Grid.Row="1" Height="1" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                    Background="{DynamicResource CardBorderBrush}" />

                    <!-- 日志 -->
                    <GroupBox Grid.Row="2" Header="日志" Margin="0,2,0,0">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,0">
                                <Button Content="复制日志" Padding="12,5" Click="BtnCopyLog_Click" Margin="0,0,8,0" />
                                <Button Content="清空日志" Padding="12,5" Click="BtnClearLog_Click" />
                            </StackPanel>
                            <RichTextBox x:Name="txtLog" FontFamily="Consolas" FontSize="12"
                                 Background="{DynamicResource WindowBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                 IsReadOnly="True"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 ContextMenu="{x:Null}" />
                        </DockPanel>
                    </GroupBox>
                </Grid>
            </DockPanel>
        </Grid>
    </Border>
</Window>