                                                     Text="{Binding ToolsDir, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="待整理的备份所在文件夹；会递归扫描所有子文件夹（带日期命名的备份文件夹视为整体，不再深入）。留空时默认使用上方「备份到」目录。" />
                                            <Button x:Name="btnToolsBrowse" Grid.Column="2" Content="浏览..." Padding="12,6" Margin="8,0,0,0"
