                                                    <TextBlock TextWrapping="Wrap" MaxWidth="420"
                                                               Text="按备份名称中的日期排序保留最新的一个。" />
                                                </TabItem.ToolTip>
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <ListView x:Name="lvPurge" Grid.Row="0" Margin="0,2,0,0" MinHeight="120" FontSize="10"
                                                              ItemsSource="{Binding PurgeItems}">
                                                        <ListView.View>
                                                            <GridView>
                                                                <GridViewColumn Header="操作" Width="70">
                                                                    <GridViewColumn.CellTemplate>
                                                                        <DataTemplate>
                                                                            <TextBlock Text="{Binding Action}" FontWeight="SemiBold">
                                                                                <TextBlock.Style>
                                                                                    <Style TargetType="TextBlock">
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding Action}" Value="删除">
                                                                                                <Setter Property="Foreground" Value="#E81123" />
                                                                                            </DataTrigger>
                                                                                            <DataTrigger Binding="{Binding Action}" Value="保留">
                                                                                                <Setter Property="Foreground" Value="{DynamicResource TextSubBrush}" />
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </TextBlock.Style>
                                                                            </TextBlock>
                                                                        </DataTemplate>
                                                                    </GridViewColumn.CellTemplate>
                                                                </GridViewColumn>
                                                                <GridViewColumn Header="名称" Width="520"
                                                                               DisplayMemberBinding="{Binding Name}" />
                                                                <GridViewColumn Header="名称日期" Width="160"
                                                                               DisplayMemberBinding="{Binding LastWriteText}" />
                                                            </GridView>
                                                        </ListView.View>
                                                    </ListView>
                                                    <Grid Grid.Row="1" Margin="0,8,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock x:Name="txtPurgeSummary" Grid.Column="0" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource TextSubBrush}" FontSize="11"
                                                                   TextWrapping="Wrap" Text="{Binding PurgeSummary}" />
                                                        <Button x:Name="btnPurgeScan" Grid.Column="1" Content="扫描预览"
                                                                Padding="12,6" Margin="0,0,8,0" Command="{Binding PurgeScanCommand}" />
                                                        <Button x:Name="btnPurgeRun" Grid.Column="2" Content="执行删除"
                                                                Style="{StaticResource AccentButton}" Padding="14,6"
                                                                Command="{Binding PurgeRunCommand}"
                                                                ToolTip="删除的备份会移入回收站，可在回收站还原。" />
                                                    </Grid>
                                                </Grid>
                                            </TabItem>

                                            <!-- 删除日期命名 -->
                                            <TabItem Header="删除日期命名" Width="150">
                                                <TabItem.ToolTip>
                                                    <TextBlock TextWrapping="Wrap" MaxWidth="420"
                                                               Text="将备份文件夹或压缩包名称结尾的「_日期」段删除；删除后同名的只保留名称中日期最新的一个，再把保留项重命名为无日期名称。如目标名称已存在，按文件修改日期取舍：候选更新则替换旧目标，目标更新则保留目标。" />
                                                </TabItem.ToolTip>
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <ListView x:Name="lvRename" Grid.Row="0" Margin="0,2,0,0" MinHeight="120" FontSize="10"
                                                              ItemsSource="{Binding RenameItems}">
                                                        <ListView.View>
                                                            <GridView>
                                                                <GridViewColumn Header="操作" Width="70">
                                                                    <GridViewColumn.CellTemplate>
                                                                        <DataTemplate>
                                                                            <TextBlock Text="{Binding Action}" FontWeight="SemiBold">
                                                                                <TextBlock.Style>
                                                                                    <Style TargetType="TextBlock">
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding Action}" Value="删除">
                                                                                                <Setter Property="Foreground" Value="#E81123" />
                                                                                            </DataTrigger>
                                                                                            <DataTrigger Binding="{Binding Action}" Value="重命名">
                                                                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                                                            </DataTrigger>
                                                                                            <DataTrigger Binding="{Binding Action}" Value="跳过">
                                                                                                <Setter Property="Foreground" Value="{DynamicResource TextSubBrush}" />
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </TextBlock.Style>
                                                                            </TextBlock>
                                                                        </DataTemplate>
                                                                    </GridViewColumn.CellTemplate>
                                                                </GridViewColumn>
                                                                <GridViewColumn Header="现名称" Width="360"
                                                                               DisplayMemberBinding="{Binding Name}" />
                                                                <GridViewColumn Header="新名称" Width="260"
                                                                               DisplayMemberBinding="{Binding NewName}" />
                                                                <GridViewColumn Header="名称日期" Width="160"
                                                                               DisplayMemberBinding="{Binding LastWriteText}" />
                                                            </GridView>
                                                        </ListView.View>
                                                    </ListView>
                                                    <Grid Grid.Row="1" Margin="0,8,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock x:Name="txtRenameSummary" Grid.Column="0" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource TextSubBrush}" FontSize="11"
                                                                   TextWrapping="Wrap" Text="{Binding RenameSummary}" />
                                                        <Button x:Name="btnRenameScan" Grid.Column="1" Content="扫描预览"
                                                                Padding="12,6" Margin="0,0,8,0" Command="{Binding RenameScanCommand}" />
                                                        <Button x:Name="btnRenameRun" Grid.Column="2" Content="执行重命名"
                                                                Style="{StaticResource AccentButton}" Padding="14,6"
                                                                Command="{Binding RenameRunCommand}"
                                                                ToolTip="多余备份移入回收站，保留项重命名为去掉日期段的名称。" />
                                                    </Grid>
                                                </Grid>
                                            </TabItem>
                                        </TabControl>
                                    </Grid>
                                        </TabItem>
                                    </TabControl>
                                </TabItem>
                            </TabControl>

                            <!-- 同步与进度 -->
                            <GroupBox x:Name="grpSyncProgress" Header="同步与进度" Margin="0,16,0,0"
                                      Visibility="{Binding ShowSyncProgress, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="btnBackup" Content="开始备份" Style="{StaticResource AccentButton}" Padding="20,7"
                                        Command="{Binding BackupCommand}" />
                                        <Button x:Name="btnSync" Grid.Column="1" Content="开始更新" Margin="8,0,0,0"
                                        Padding="20,7" Style="{StaticResource AccentButton}" Command="{Binding SyncCommand}" />
                                        <Button x:Name="btnUpdateProgram" Grid.Column="2" Content="程序升级" Margin="8,0,0,0"
                                        Padding="20,7" Style="{StaticResource AccentButton}" Command="{Binding UpdateProgramCommand}" />
                                        <Button x:Name="btnCancel" Grid.Column="4" Content="取消" Command="{Binding CancelCommand}" />
                                    </Grid>
                                    <ProgressBar x:Name="progressBar" Margin="0,12,0,0" Minimum="0"
                                                 Maximum="{Binding ProgressMaximum}" Value="{Binding ProgressValue}" />
                                    <TextBlock x:Name="txtCur" Margin="0,7,0,0" Text="{Binding CurrentFileText}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </GroupBox>

                            <!-- Windows 共享连接 -->
                            <GroupBox x:Name="grpShare" Header="Windows 共享连接" Margin="0,16,0,0"
                                      IsEnabled="{Binding IsNotBusy}"
                                      Visibility="{Binding ShowShareGroup, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="远端IP:" VerticalAlignment="Center" FontWeight="SemiBold" />
                                        <TextBox x:Name="txtShareIp" Grid.Column="1" Margin="8,0,0,0" Height="30"
                                         Text="{Binding ShareIp, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="远端电脑 IP，例如 192.168.1.8" />
                                        <TextBlock Grid.Column="2" Text="用户名:" Margin="16,0,0,0" VerticalAlignment="Center" />
                                        <TextBox x:Name="txtShareUser" Grid.Column="3" Margin="8,0,0,0" Height="30"
                                         Text="{Binding ShareUser, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="共享账号(留空用当前 Windows 账号)" />
                                        <TextBlock Grid.Column="4" Text="密码:" Margin="16,0,0,0" VerticalAlignment="Center" />
                                        <PasswordBox x:Name="pwdSharePass" Grid.Column="5" Margin="8,0,0,0" Height="30"
                                             ToolTip="共享密码(可留空)" />
                                        <TextBlock Grid.Column="6" Text="共享路径:" Margin="16,0,0,0" VerticalAlignment="Center" />
                                        <TextBox x:Name="txtSharePath" Grid.Column="7" Margin="8,0,0,0" Height="30"
                                         Text="{Binding SharePath, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="远端共享的 BBK 路径。默认 c$\BBK 即远端 C 盘 BBK；若共享名为 BBK 则填 BBK" />
                                    </Grid>
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="btnShareTest" Content="测试连接" Padding="14,6" Command="{Binding ShareTestCommand}" />
                                        <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSubBrush}" TextWrapping="Wrap"
                                           Text="远端只需共享 D:\BBK(或开放 c$ 管理共享)，无需安装本程序。" />
                                    </Grid>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 日志区拖拽分隔条 -->
                    <GridSplitter Grid.Row="1" Height="7" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                          Background="Transparent" Cursor="SizeNS" ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Rows" />
                    <Border Grid.Row="1" Height="1" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                    Background="{DynamicResource CardBorderBrush}" />

                    <!-- 日志：日志框铺满到底，工具按钮悬浮框内右下；
                         文档尾部占位块保证滚到底时最后一行不被按钮遮挡 -->
                    <GroupBox Grid.Row="2" Header="日志" Margin="0,2,0,0">
                        <Grid>
                            <RichTextBox x:Name="txtLog" FontFamily="Consolas" FontSize="12"
                                 Padding="4,2,4,0"
                                 Background="{DynamicResource WindowBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                 IsReadOnly="True"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 ContextMenu="{x:Null}"
                                 mvvm:LogView.Entries="{Binding LogEntries}">
                                <!--  文档尾部占位块：作为可滚动内容的一部分，保证滚到底时
                                      最后一条日志停在悬浮按钮上方，而日志框背景边框依旧铺满到底  -->
                                <FlowDocument PagePadding="0">
                                    <BlockUIContainer x:Name="logBottomSpacer">
                                        <Border Height="40" IsHitTestVisible="False" />
                                    </BlockUIContainer>
                                </FlowDocument>
                            </RichTextBox>
                            <!--  右距 20 = 垂直滚动条 10 + 边框内边距 4 + 间隙 6，面板不遮挡滚动条  -->
                            <Border x:Name="btnLogPanel" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    Margin="0,0,20,1"
                                    Background="{DynamicResource WindowBgBrush}" CornerRadius="8" Padding="2">
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="清空日志" Padding="12,5" Command="{Binding ClearLogCommand}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </GroupBox>
                </Grid>
            </DockPanel>
        </Grid>
    </Border>
    </Grid>
</Window>
