<Window x:Class="LanFileSync.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:LanFileSync"
        xmlns:mvvm="clr-namespace:LanFileSync.Mvvm"
        Title="{Binding WindowTitle}"
        Icon="/app.ico"
        MinHeight="680" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent"
        BorderBrush="Transparent" BorderThickness="0"
        TextElement.FontFamily="Microsoft YaHei UI, Segoe UI Variable, Segoe UI"
        TextElement.FontSize="13"
        Loaded="MainWindow_Loaded"
        StateChanged="Window_StateChanged"
        Closing="Window_Closing">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Grid x:Name="rootHost">
    <Border x:Name="rootBorder" BorderThickness="0" CornerRadius="12">
        <Grid x:Name="rootContent" Background="{DynamicResource WindowBgBrush}"
              local:CornerClip.Radius="11">
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 自定义标题栏 -->
            <Border x:Name="titleBarBorder" Grid.Row="0" Background="{DynamicResource TitleBarBgBrush}"
                    BorderBrush="{DynamicResource TitleBarBorderBrush}" BorderThickness="0,0,0,1">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="btnHelp" Style="{StaticResource TitleBarButton}"
                                Command="{Binding ShowHelpCommand}" ToolTip="查看使用说明（README）"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <TextBlock Text="?" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                        <Button x:Name="btnThemeToggle" Style="{StaticResource ThemeToggleButton}"
                                Click="BtnThemeToggle_Click" Margin="0,0,4,0"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                        <Button Style="{StaticResource TitleBarButton}" Click="TitleMin_Click" ToolTip="最小化"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <Path Width="12" Height="12" Stretch="Uniform" Data="M0,6 H10"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" />
                        </Button>
                        <Button Style="{StaticResource TitleBarButton}" Click="TitleMax_Click" ToolTip="最大化 / 还原"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <Path Width="12" Height="12" Stretch="Uniform" Data="M1,1 H9 V9 H1 Z"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" />
                        </Button>
                        <Button Style="{StaticResource TitleBarButtonClose}" Click="TitleClose_Click" ToolTip="关闭"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <Path Width="12" Height="12" Stretch="Uniform" Data="M1,1 L9,9 M9,1 L1,9"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" />
                        </Button>
                    </StackPanel>
                    <Image Source="/app.ico" Width="18" Height="18" Margin="10,0,10,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="txtTitle" Text="{Binding AppTitle}" VerticalAlignment="Center" FontWeight="SemiBold"
                               Foreground="{DynamicResource TitleFgBrush}" TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Border>

            <!-- 主界面内容 -->
            <DockPanel Grid.Row="1">
                <!-- 底部状态栏 -->
                <Border DockPanel.Dock="Bottom" Height="30" Background="{DynamicResource StatusBarBgBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0">
                    <DockPanel Margin="12,0">
                        <TextBlock DockPanel.Dock="Right" x:Name="txtLocalIp" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSubBrush}" Text="{Binding LocalIpText}" TextElement.FontSize="12" />
                        <TextBlock x:Name="txtStatus" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextMainBrush}" Text="{Binding StatusText}" TextElement.FontSize="12" />
                    </DockPanel>
                </Border>

                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="210" MinHeight="90" />
                    </Grid.RowDefinitions>

                    <!-- 主操作区：整窗横跨排列 -->
                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- 第一行：本机服务 | 远端电脑 -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <GroupBox Header="本机配置" IsEnabled="{Binding IsNotBusy}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="BBK文件夹:" VerticalAlignment="Center" FontWeight="SemiBold" />
                                            <TextBox x:Name="txtRoot" Grid.Column="1" Margin="8,0,0,0" Height="30" HorizontalAlignment="Stretch"
                                                     Text="{Binding RootPath, UpdateSourceTrigger=PropertyChanged}" />
                                            <Button Grid.Column="2" Content="浏览..." Padding="12,6" Margin="8,0,0,0"
                                                    Command="{Binding BrowseRootCommand}" />
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="16,0,0,0">
                                                <TextBlock Text="端口:" VerticalAlignment="Center" FontWeight="SemiBold" />
                                                <TextBox x:Name="txtPort" Margin="8,0,0,0" Height="30" Width="80"
                                                         ToolTip="本机服务监听端口"
                                                         Text="{Binding PortText, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                        </Grid>
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox x:Name="chkAutoStart" FontWeight="Normal"
                                              Content="开机自启并后台监听（驻留托盘）"
                                              VerticalAlignment="Center" IsChecked="{Binding IsAutoStart}" />
                                            <Button x:Name="btnStart" Grid.Column="2" Content="启动服务" Margin="10,0,0,0"
                                                    Command="{Binding StartServerCommand}" />
                                            <Button x:Name="btnStop" Grid.Column="3" Content="停止服务" Margin="8,0,0,0"
                                                    Command="{Binding StopServerCommand}" />
                                        </Grid>
                                    </StackPanel>
                                </GroupBox>

                                <GroupBox Grid.Column="1" Header="远端电脑" Margin="14,0,0,0" IsEnabled="{Binding IsNotBusy}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="IP/范围:" VerticalAlignment="Center" FontWeight="SemiBold" />
                                            <ComboBox x:Name="cboPeerIp" Grid.Column="1" Margin="8,0,0,0" Height="30" IsEditable="True"
                                          VerticalContentAlignment="Center"
                                          ItemsSource="{Binding PeerHistory}"
                                          Text="{Binding PeerIp, UpdateSourceTrigger=PropertyChanged}"
                                          ToolTip="可下拉选择历史记录，也可输入多个 IP（逗号分隔）或范围，如 192.168.1.5-8">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Label}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <Button x:Name="btnTestConnect" Grid.Column="2" Content="测试连接" Margin="8,0,0,0" Padding="10,6"
                                            Command="{Binding TestConnectionCommand}" ToolTip="对输入的所有 IP/范围逐一验证 TCP 连接与远端协议应答，并输出成功/失败结果" />
                                            <Button x:Name="btnHistory" Grid.Column="3" Content="历史" Margin="8,0,0,0" Padding="10,6"
                                            Command="{Binding ShowHistoryCommand}" ToolTip="管理历史连接的 IP 与备注" />
                                            <Button x:Name="btnComputers" Grid.Column="4" Content="IP配置" Margin="8,0,0,0" Padding="10,6"
                                            Command="{Binding ShowComputersCommand}" ToolTip="配置 IP 与电脑名称的对应关系，用于下拉选择和备份自动命名" />
                                        </Grid>
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="远端端口:" VerticalAlignment="Center" FontWeight="SemiBold" />
                                            <TextBox x:Name="txtPeerPort" Grid.Column="1" Width="90" Margin="8,0,0,0" Height="30"
                                             ToolTip="远端服务监听端口，默认与本机端口一致"
                                             Text="{Binding PeerPortText, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSubBrush}" TextWrapping="Wrap" FontSize="10"
                                               Text="多台依次处理：逗号或分号分隔，如 [192.168.1.5,192.168.1.6]、[192.168.1.5,6;8]、[192.168.1.5-8]、[192.168.1.5-192.168.1.8]" />
                                        </Grid>
                                    </StackPanel>
                                </GroupBox>
                            </Grid>

                            <!-- 选项卡：备份 / 更新(横跨整个界面) -->
                            <TabControl x:Name="tabs" Margin="0,16,0,0" SelectionChanged="Tabs_SelectionChanged">
                                <TabItem Header="BBK备份" Width="100" ToolTip="备份本机或远端BBK文件夹，根据文件日期选择性备份Log">
                                    <Grid Margin="0" IsEnabled="{Binding IsNotBusy}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="来源:" VerticalAlignment="Center" FontWeight="SemiBold" />
                                                <RadioButton x:Name="rbBackupLocal" GroupName="bsrc" Content="本机" Margin="10,0,0,0" VerticalAlignment="Center"
                                                             IsChecked="{Binding IsBackupLocal}" />
                                                <RadioButton x:Name="rbBackupRemote" GroupName="bsrc" Content="局域网电脑(可多台)" Margin="10,0,0,0" VerticalAlignment="Center"
                                                             IsChecked="{Binding IsBackupRemote}" />
                                                <RadioButton x:Name="rbBackupShare" GroupName="bsrc" Content="Windows共享" Margin="10,0,0,0" VerticalAlignment="Center"
                                                             IsChecked="{Binding IsBackupShare}" />
                                            </StackPanel>
                                            <TextBlock x:Name="txtBackupHint" Margin="0,7,0,0" Foreground="{DynamicResource TextSubBrush}" TextWrapping="Wrap" FontSize="10" FontWeight="Normal"
                                               Text="局域网电脑备份用上方「远端电脑」的 IP/范围，逐台处理；Windows共享用下方连接。" />
                                            <Grid Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="备份到:" VerticalAlignment="Center" FontWeight="SemiBold" />
                                                <TextBox x:Name="txtBackupDest" Grid.Column="1" Margin="8,0,0,0" Height="30" FontWeight="Normal"
                                                 ToolTip="备份目标父目录，自动存入 备份目录\BBK_电脑名称_日期"
                                                 Text="{Binding BackupDestPath, UpdateSourceTrigger=PropertyChanged}" />
                                                <Button Grid.Column="2" Content="浏览..." Padding="12,6" Margin="8,0,0,0"
                                                        Command="{Binding BrowseBackupDestCommand}" />
                                            </Grid>
                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                <CheckBox x:Name="cbBackupLogRule" Content="Log 文件夹只备份最近" VerticalAlignment="Center"
                                                          IsChecked="{Binding BackupLogRule}" />
                                                <TextBox x:Name="txtBackupLogDays" Width="50" Height="20" Margin="6,0" VerticalContentAlignment="Center"
                                                         ToolTip="设置 0 时不备份 Log 文件夹"
                                                         Text="{Binding BackupLogDaysText, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Text="天" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <StackPanel x:Name="rowLocalName" Orientation="Horizontal" Margin="0,8,0,0">
                                                <CheckBox x:Name="cbAutoFetchName" VerticalAlignment="Center"
                                                  IsChecked="{Binding AutoFetchName}"
                                                  Content="自动获取设备配置"
                                                  ToolTip="勾选后自动从备份电脑 BBK 文件夹子目录的 Config\SystemConfig.xml 解析 DeviceNo/LineNo 作为备份命名与存放。" />
                                            </StackPanel>
                                            <CheckBox x:Name="cbCompressZip" Content="备份完成后自动压缩为 zip（删除文件夹）" Margin="0,8,0,0"
                                              IsChecked="{Binding CompressZip}"
                                              ToolTip="备份完成后打包为同名 zip 并删除文件夹。" />
                                            <CheckBox x:Name="cbRunPreBackupBat" Content="备份前先执行 PostgreSQL 备份脚本" Margin="0,8,0,0"
                                              IsChecked="{Binding RunPreBackupBat}"
                                              ToolTip="勾选后备份前先在目标电脑执行 PostgreSQL_Backup.bat（含 pg_dump 数据库备份）。局域网备份在远端执行后拉取。" />
                                        </StackPanel>
                                        <Rectangle Grid.Column="1" Width="1" Fill="{DynamicResource CardBorderBrush}" Margin="14,0" />
                                        <StackPanel Grid.Column="2" Margin="5,0,0,0">
                                            <CheckBox x:Name="cbIgnoreEnabled" Content="启用忽略规则(正则表达式)"
                                              IsChecked="{Binding IgnoreEnabled}"
                                              ToolTip="取消勾选后，下面的忽略规则不生效，所有文件都会被备份。" />
                                            <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource TextSubBrush}" TextWrapping="Wrap" FontSize="10" FontWeight="Normal"
                                               Text="忽略文件/文件夹(每行一条正则表达式，匹配相对路径)：" />
                                            <TextBox x:Name="txtBackupIgnore" Margin="0,4,0,0" Height="60" AcceptsReturn="True"
                                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalAlignment="Stretch"
                                             Text="{Binding BackupIgnore, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="每行一条合法正则表达式，大小写不敏感，匹配文件/文件夹相对源目录的路径，命中即忽略备份。&#x0a;&#x0a;忽略文件示例：&#x0a;&#x0a;  Log\.log$           结尾为 Log.log 的文件&#x0a;&#x0a;  \.bak$              所有 .bak 文件(注意 * 号无效，这是正则)&#x0a;&#x0a;  副本                 路径中含「副本」的文件&#x0a;&#x0a;忽略文件夹示例：&#x0a;&#x0a;  (^|/)\.git(/|$)      任何路径下的 .git 文件夹&#x0a;&#x0a;  (^|/)Temp(/|$)       顶层 Temp 文件夹&#x0a;&#x0a;  若要整条容错，可用 ^ 和 $ 锁定。" />
                                            <TextBlock x:Name="txtIgnoreExample" Margin="0,6,0,0" Foreground="{DynamicResource TextSubBrush}" TextWrapping="Wrap" FontSize="10" FontWeight="Normal"
                                               Text="示例：忽略 .bak 文件：\.bak$；忽略全部副本文件：副本；忽略 .git 文件夹：(^|/)\.git(/|$)。" />
                                            <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource TextSubBrush}" TextWrapping="Wrap" FontSize="10" FontWeight="Normal"
                                               Text="备份自动存入 备份目录\BBK_电脑名称_日期。" />
                                        </StackPanel>
                                    </Grid>
                                </TabItem>
                                <TabItem Header="BBK更新" Width="100" ToolTip="一键更新本地或远端BBK，自动跳过Config和Log文件夹；更新前选择性备份BBK文件夹(默认备份)">
                                    <Grid Margin="0" IsEnabled="{Binding IsNotBusy}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="更新方式" FontWeight="SemiBold" Foreground="{DynamicResource TextSubBrush}" Margin="0,0,0,6" />
                                            <RadioButton x:Name="rbReceive" GroupName="dir" Content="接收远端更新（远端为源）" Margin="0,3,0,0"
                                                         IsChecked="{Binding IsReceiveSelected}" />
                                            <RadioButton x:Name="rbPush" GroupName="dir" Content="推送本机到远端（本机为源）" Margin="0,6,0,0"
                                                         IsChecked="{Binding IsPushSelected}" />
                                            <RadioButton x:Name="rbSyncShare" GroupName="dir" Content="从共享文件夹更新本机（免安装）" Margin="0,6,0,0"
                                                         IsChecked="{Binding IsSyncShareSelected}" />
                                            <TextBlock x:Name="txtHint" Margin="0,8,0,0" Foreground="{DynamicResource TextSubBrush}" TextWrapping="Wrap" FontSize="10" FontWeight="Normal"
                                               Text="{Binding UpdateHint}" />
                                            <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource TextSubBrush}" TextWrapping="Wrap" FontSize="10" FontWeight="Normal"
                                               Text="说明：更新BBK文件夹，自动跳过 Log 与 Config 文件夹。" />
                                        </StackPanel>
                                        <Rectangle Grid.Column="1" Width="1" Fill="{DynamicResource CardBorderBrush}" Margin="14,0" />
                                        <StackPanel Grid.Column="2" Margin="14,0,0,0">
                                            <TextBlock Text="更新规则（接收 / 从共享时生效）" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSubBrush}" Margin="0,0,0,6" />
                                            <CheckBox x:Name="cbBinReplace" Content="Bin 整体替换（不勾则按日期增量）" Margin="0,3,0,0"
                                              IsChecked="{Binding BinReplace}"
                                              ToolTip="勾选：先删除本地 Bin 再整体拷贝。不勾选：按修改日期/大小只同步不同的文件。" />

                                            <CheckBox x:Name="cbBackupBeforeSync" Margin="0,10,0,0"
                                              Content="同步前先备份被更新电脑的 BBK"
                                              IsChecked="{Binding BackupBeforeSync}"
                                              ToolTip="TCP 接收更新、从共享更新本机、或远端推送更新时，都会先把被更新那台电脑的 BBK 备份到「备份目录」再开始同步。" />
                                            <CheckBox x:Name="cbUpdateCompressZip" Margin="0,6,0,0"
                                              Content="备份完成后自动压缩为 zip（删除文件夹）"
                                              IsChecked="{Binding UpdateCompressZip}"
                                              ToolTip="同步前备份完成后自动打包为 zip 并删除文件夹。" />
                                        </StackPanel>
                                        <!-- 半透明玻璃遮罩(密码保护) -->
                                        <Border x:Name="updateOverlay" Grid.ColumnSpan="3"
                                                CornerRadius="8" IsHitTestVisible="True" ClipToBounds="True"
                                                Visibility="{Binding IsUpdateLocked, Converter={StaticResource BoolToVisibility}}">
                                            <Grid>
                                                <Border Background="{DynamicResource OverlayBgBrush}" CornerRadius="8">
                                                    <Border.Effect>
                                                        <BlurEffect Radius="6" KernelType="Gaussian" />
                                                    </Border.Effect>
                                                </Border>
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="500">
                                                    <TextBlock Text="请输入密码以使用更新功能" FontSize="18"
                                                               Foreground="{DynamicResource TextMainBrush}" HorizontalAlignment="Center" Margin="0,10,0,5" />
                                                    <Border HorizontalAlignment="Stretch" Background="{DynamicResource CardBgBrush2}"
                                                            BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1"
                                                            CornerRadius="8" SnapsToDevicePixels="True">
                                                        <Grid Height="40" HorizontalAlignment="Stretch">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <PasswordBox x:Name="pwdUpdate" Grid.Column="0"
                                                                         FontSize="14" Padding="10,6,5,6" BorderThickness="0"
                                                                         Background="Transparent" VerticalContentAlignment="Center"
                                                                         KeyDown="PwdUpdate_KeyDown" />
                                                            <TextBox x:Name="txtUpdatePwd" Grid.Column="0"
                                                                     FontSize="14" Padding="10,6,5,6" VerticalContentAlignment="Center"
                                                                     Visibility="Collapsed" BorderThickness="0" Background="Transparent"
                                                                     KeyDown="PwdUpdate_KeyDown" />
                                                            <Button x:Name="btnTogglePwd" Grid.Column="1" Width="50"
                                                                    Margin="0,0,4,0" Cursor="Hand"
                                                                    Background="Transparent" BorderThickness="0"
                                                                    Click="BtnTogglePwd_Click"
                                                                    ToolTip="显示 / 隐藏密码">
                                                                <Grid Width="18" Height="18">
                                                                    <Path x:Name="eyeIcon" Stretch="Uniform"
                                                                          Data="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"
                                                                          Fill="{DynamicResource TextSubBrush}" />
                                                                    <Line x:Name="eyeLine" X1="2" Y1="2" X2="22" Y2="22"
                                                                          Stroke="{DynamicResource TextSubBrush}" StrokeThickness="2"
                                                                          Visibility="Visible" />
                                                                </Grid>
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                    <Button Content="确认" Padding="14,6" HorizontalAlignment="Center"
                                                            Margin="0,5,0,0" Click="BtnUpdateUnlock_Click"
                                                            Style="{StaticResource AccentButton}" />
                                                    <TextBlock x:Name="txtUpdateError" Text="密码错误" FontSize="11"
                                                               Foreground="#E81123" HorizontalAlignment="Center" Margin="0,6,0,0"
                                                               Visibility="Collapsed" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </TabItem>
                                <TabItem Header="文件同步" Width="100" ToolTip="同步本地或远端文件；可选更新模式(先备份再原替换文件)和拷贝模式(新文件以重命名的方式保存，原文件不动)">
                                    <Grid Margin="0" IsEnabled="{Binding IsNotBusy}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel x:Name="transferContent" IsEnabled="{Binding IsTransferContentEnabled}">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <RadioButton x:Name="rbTransferPush" GroupName="transferDir" Content="同步给远端"
                                                             IsChecked="{Binding IsTransferToRemote}" />
                                                <RadioButton x:Name="rbTransferPull" GroupName="transferDir" Content="从远端同步" Margin="12,0,0,0"
                                                             IsChecked="{Binding IsTransferFromRemote}" />
                                            </StackPanel>
                                            <Grid Margin="0,0,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
<TextBlock Text="路径:" VerticalAlignment="Center" FontWeight="SemiBold" />
