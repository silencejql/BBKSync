                                <TabItem Header="小工具" Width="100"
                                         ToolTip="整理备份文件夹或压缩包：剔除旧备份、删除名称中的日期段">
                                    <TabControl IsEnabled="{Binding IsToolsIdle}">
                                        <TabItem Header="备份整理" Width="150">
                                    <Grid Margin="0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <!-- 共用的待整理文件夹 -->
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="文件夹:" VerticalAlignment="Center" FontWeight="SemiBold" />
