<Window x:Class="LanFileSync.DarkMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="提示" Width="420" MinHeight="180" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize"
        Background="Transparent"
        BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="2"
        TextElement.FontFamily="Microsoft YaHei UI, Segoe UI Variable, Segoe UI"
        TextElement.FontSize="13">
    <WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32" GlassFrameThickness="0" CornerRadius="0"
                            ResizeBorderThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Grid Background="{DynamicResource WindowBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource TitleBarBgBrush}" BorderBrush="{DynamicResource TitleBarBorderBrush}" BorderThickness="0,0,0,1">
            <TextBlock x:Name="txtTitle" VerticalAlignment="Center" Margin="12,0,0,0"
                       Foreground="{DynamicResource TitleFgBrush}" FontWeight="SemiBold" />
        </Border>

        <Grid Grid.Row="1" Margin="20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                <TextBlock x:Name="txtIcon" FontSize="28" VerticalAlignment="Top" Margin="0,0,12,0"
                           FontFamily="Segoe UI Emoji, Segoe UI Symbol" />
                <TextBlock x:Name="txtMessage" VerticalAlignment="Center" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextMainBrush}" MaxWidth="320" />
            </StackPanel>

            <StackPanel x:Name="panelButtons" Grid.Row="1" Orientation="Horizontal"
                        HorizontalAlignment="Right" />
        </Grid>
    </Grid>
</Window>
