<Window x:Class="LanFileSync.DarkMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="提示" Width="452" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        TextElement.FontFamily="Microsoft YaHei UI, Segoe UI Variable, Segoe UI"
        TextElement.FontSize="13"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <!-- 弹窗次按钮：描边轻量风格，悬停轻微灰化 -->
        <Style x:Key="DlgSecondaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextMainBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="20,7" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="6" SnapsToDevicePixels="True"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#18808080" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2C808080" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 标题栏关闭按钮 -->
        <Style x:Key="DlgCloseButton" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Foreground" Value="{DynamicResource TextSubBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="6" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#18808080" />
                                <Setter Property="Foreground" Value="{DynamicResource TextMainBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Border CornerRadius="12" Background="{DynamicResource WindowBgBrush}"
                BorderBrush="{DynamicResource WindowFrameBrush}" BorderThickness="1">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 标题栏 -->
                <Border Grid.Row="0" Height="46" CornerRadius="12,12,0,0"
                        Background="{DynamicResource TitleBarBgBrush}">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                            <Border Width="4" Height="18" CornerRadius="2" Background="{DynamicResource AccentBrush}"
                                    VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock x:Name="txtTitle" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMainBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button x:Name="btnClose" Style="{StaticResource DlgCloseButton}"
                                Content="&#xE921;" HorizontalAlignment="Right" Margin="0,0,10,0"
                                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                Click="BtnClose_Click" />
                    </Grid>
                </Border>

                <!-- 内容：图标徽章 + 消息 -->
                <Grid Grid.Row="1" Margin="22,20,22,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border x:Name="badgeIcon" Grid.Column="0" Width="38" Height="38" CornerRadius="19"
                            VerticalAlignment="Top" Margin="0,2,14,0">
                        <TextBlock x:Name="txtIcon" FontSize="18" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontFamily="Segoe UI Symbol, Segoe UI Emoji" />
                    </Border>

                    <TextBlock x:Name="txtMessage" Grid.Column="1"
                               Foreground="{DynamicResource TextMainBrush}"
                               TextWrapping="Wrap" MaxWidth="330"
                               LineHeight="23" LineStackingStrategy="BlockLineHeight"
                               VerticalAlignment="Center" />
                </Grid>

                <!-- 按钮区 -->
                <Border Grid.Row="2" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0">
                    <StackPanel x:Name="panelButtons" Orientation="Horizontal"
                                HorizontalAlignment="Right" Margin="18,12" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
