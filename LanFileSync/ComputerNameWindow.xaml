<Window x:Class="LanFileSync.ComputerNameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="IP 与电脑名称配置" Width="480" Height="440" MinWidth="420" MinHeight="360"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent"
        BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="2"
        TextElement.FontFamily="Microsoft YaHei UI, Segoe UI Variable, Segoe UI"
        TextElement.FontSize="13">
    <WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32" GlassFrameThickness="0" CornerRadius="0"
                            ResizeBorderThickness="8" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource TitleBarBgBrush}"
                BorderBrush="{DynamicResource TitleBarBorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource TitleBarButtonClose}" Click="TitleClose_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Path Width="12" Height="12" Stretch="Uniform" Data="M1,1 L9,9 M9,1 L1,9"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" />
                    </Button>
                </StackPanel>
                <TextBlock Text="IP 与电脑名称配置" VerticalAlignment="Center" Margin="12,0,0,0"
                           Foreground="{DynamicResource TitleFgBrush}" FontWeight="SemiBold" />
            </DockPanel>
        </Border>

        <DockPanel Grid.Row="1" Margin="14">
            <TextBlock DockPanel.Dock="Top" Foreground="{DynamicResource TextSubBrush}" TextWrapping="Wrap"
                       Text="配置 IP 与电脑名称的对应关系，备份时会自动命名「备份目录\BBK_电脑名称_日期」。未配置名称的 IP 自身命名。" Margin="0,0,0,10" />
            <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,10" Padding="0,0,0,10">
                <StackPanel Orientation="Horizontal">
                    <Button Content="添加一行" Padding="14,6" Click="Add_Click" />
                    <Button Content="删除所选" Margin="8,0,0,0" Padding="14,6" Click="Remove_Click" />
                    <Button Content="保存并关闭" Margin="12,0,0,0" Style="{StaticResource AccentButton}" Padding="14,6" Click="SaveClose_Click" />
                </StackPanel>
            </Border>
            <DataGrid x:Name="grid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                      HeadersVisibility="Column" GridLinesVisibility="All" HorizontalGridLinesBrush="{DynamicResource CardBorderBrush}"
                      VerticalGridLinesBrush="{DynamicResource CardBorderBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                      RowHeight="30">
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="电脑 IP" Binding="{Binding Path=Ip, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                    <DataGridTextColumn Header="电脑名称" Binding="{Binding Path=Name, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Grid>
</Window>