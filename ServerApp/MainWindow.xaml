<Window x:Class="LanFileSync.ServerApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BBK 远端服务程序"
        Height="700" Width="660"
        MinHeight="560" MinWidth="560"
        WindowStartupLocation="CenterScreen"
        Background="#F7F8FA"
        TextElement.FontFamily="Microsoft YaHei UI, Segoe UI"
        TextElement.FontSize="13"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <GroupBox Grid.Row="0" Header="监听设置">
            <StackPanel>
                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="监听端口：" VerticalAlignment="Center" />
                    <TextBox x:Name="txtPort" Grid.Column="1" />
                </Grid>
                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="BBK 根目录：" VerticalAlignment="Center" />
                    <TextBox x:Name="txtRoot" Grid.Column="1" Margin="0,0,8,0" />
                    <Button x:Name="btnBrowseRoot" Grid.Column="2" Content="浏览..." Width="72" Height="28"
                            Click="BtnBrowseRoot_Click" />
                </Grid>
                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="备份目录：" VerticalAlignment="Center" />
                    <TextBox x:Name="txtBackupDest" Grid.Column="1" Margin="0,0,8,0" />
                    <Button x:Name="btnBrowseBackup" Grid.Column="2" Content="浏览..." Width="72" Height="28"
                            Click="BtnBrowseBackup_Click" />
                </Grid>
            </StackPanel>
        </GroupBox>

        <GroupBox Grid.Row="1" Header="被推送更新时的备份选项">
            <StackPanel>
                <CheckBox x:Name="cbBackupBeforeSync" Content="同步前先备份本机 BBK" Margin="0,2" />
                <CheckBox x:Name="cbCompressUpdateZip" Content="同步前备份完成后压缩为 zip" Margin="0,2" />
                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="cbLogRule" Content="按日志规则只保留最近" VerticalAlignment="Center" />
                    <TextBox x:Name="txtLogDays" Grid.Column="1" Margin="8,0" />
                    <TextBlock Grid.Column="2" Text="天的 Log 文件" VerticalAlignment="Center" />
                </Grid>
                <CheckBox x:Name="cbIgnoreEnabled" Content="启用文件名忽略正则" Margin="0,2" />
                <TextBox x:Name="txtIgnoreRegexes" Height="56" Margin="22,4,0,2"
                         AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
            </StackPanel>
        </GroupBox>

        <GroupBox Grid.Row="2" Header="服务运行">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="btnStart" Content="启动服务" Style="{StaticResource PrimaryButton}"
                            Click="BtnStart_Click" />
                    <Button x:Name="btnStop" Content="停止服务" Style="{StaticResource GhostButton}"
                            IsEnabled="False" Click="BtnStop_Click" />
                    <CheckBox x:Name="cbAutoStart" Content="启动程序时自动开始监听" VerticalAlignment="Center"
                              Margin="10,0,0,0" />
                </StackPanel>
                <TextBlock x:Name="txtStatus" Margin="2,8,0,0" TextWrapping="Wrap"
                           Foreground="#555555" Text="服务未启动" />
            </StackPanel>
        </GroupBox>

        <GroupBox Grid.Row="3" Header="运行日志">
            <TextBox x:Name="txtLog" IsReadOnly="True" Background="White" BorderBrush="#D8D8DE"
                     FontFamily="Consolas, Microsoft YaHei UI" FontSize="11"
                     HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                     TextWrapping="NoWrap" />
        </GroupBox>
    </Grid>
</Window>
